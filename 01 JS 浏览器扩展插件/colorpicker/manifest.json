{
    "manifest_version": 3,
    "name": "页面配色器",
    "version": "1.0",
    "description": "一键改变网页背景颜色",
    "action":{
        "default_popup": "popup.html",
        "default_title": "网页配色器"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}