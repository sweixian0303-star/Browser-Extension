{
    "manifest_version":3,
    "name": "专注模式",
    "version": "1.0",
    "description": "屏蔽干扰元素， 专注阅读",
    "action":{
        "default_popup": "popup.html",
        "default_title": "专注模式"
    },
    "permissions":["activeTab", "scripting", "storage"],
    "content_scripts":[
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}